#include <stdio.h>

int getMax(int a[], int n)
{
    int max = a[0];

    for (int i = 1; i < n; i++)
    {
        if (a[i] > max)
            max = a[i];
    }

    return max;
}

void radixSort(int a[], int n)
{
    int max = getMax(a, n);
    int place;

    for (place = 1; max / place > 0; place = place * 10)
    {
        int output[100];
        int count[10] = {0};

        // Count digits
        for (int i = 0; i < n; i++)
        {
            int digit = (a[i] / place) % 10;
            count[digit]++;
        }

        // Find positions
        for (int i = 1; i < 10; i++)
            count[i] = count[i] + count[i - 1];

        // Put elements in output
        for (int i = n - 1; i >= 0; i--)
        {
            int digit = (a[i] / place) % 10;

            output[count[digit] - 1] = a[i];
            count[digit]--;
        }

        // Copy back
        for (int i = 0; i < n; i++)
            a[i] = output[i];
    }
}

int main()
{
    int a[] = {170, 45, 75, 90, 802, 24, 2, 66};
    int n = 8;

    radixSort(a, n);

    for (int i = 0; i < n; i++)
        printf("%d ", a[i]);

    return 0;
}
