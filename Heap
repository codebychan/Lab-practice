#include <stdio.h>

#define MAX 100

int heap[MAX];
int n = 0;

void heapifyUp(int i)
{
    int parent;

    while (i > 0)
    {
        parent = (i - 1) / 2;

        if (heap[parent] <= heap[i])
            break;

        int temp = heap[parent];
        heap[parent] = heap[i];
        heap[i] = temp;

        i = parent;
    }
}

void heapifyDown(int i)
{
    int left, right, smallest;

    while (1)
    {
        left = 2 * i + 1;
        right = 2 * i + 2;
        smallest = i;

        if (left < n && heap[left] < heap[smallest])
            smallest = left;

        if (right < n && heap[right] < heap[smallest])
            smallest = right;

        if (smallest == i)
            break;

        int temp = heap[i];
        heap[i] = heap[smallest];
        heap[smallest] = temp;

        i = smallest;
    }
}

void insert(int value)
{
    if (n == MAX)
    {
        printf("Heap is full\n");
        return;
    }

    heap[n] = value;
    n++;

    heapifyUp(n - 1);
}

void deleteMin()
{
    if (n == 0)
    {
        printf("Heap is empty\n");
        return;
    }

    printf("Deleted element: %d\n", heap[0]);

    heap[0] = heap[n - 1];
    n--;

    heapifyDown(0);
}

void display()
{
    int i;

    printf("Heap: ");

    for (i = 0; i < n; i++)
        printf("%d ", heap[i]);

    printf("\n");
}

int main()
{
    insert(40);
    insert(20);
    insert(10);
    insert(50);
    insert(30);
    insert(5);

    display();

    deleteMin();

    display();

    deleteMin();

    display();

    return 0;
}
